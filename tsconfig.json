{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "@open-slide/core/env"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "slides/**/*",
    "teacher-slides/**/*",
    "live/shared/**/*",
    "live/client/**/*",
    "open-slide.config.ts"
  ],
  "exclude": [
    "**/*.test.ts"
  ]
}
