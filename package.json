{
  "name": "slides-littleyao",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "open-slide dev",
    "build": "open-slide build",
    "preview": "open-slide preview",
    "sync:skills": "open-slide sync:skills",
    "test:live": "~/.nvm/versions/node/v24.20.0/bin/node --test 'live/**/*.test.ts'",
    "dev:worker": "npx -y wrangler@4.86.0 dev -c live/worker/wrangler.jsonc --port 8787 --host localhost",
    "dev:teacher": "OPEN_SLIDE_SLIDES_DIR=teacher-slides open-slide dev --port 5174",
    "build:teacher": "OPEN_SLIDE_SLIDES_DIR=teacher-slides open-slide build --out-dir dist-teacher",
    "check:public": "node live/scripts/check-public-build.mjs dist"
  },
  "dependencies": {
    "@open-slide/core": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "vite": "^5.4.10"
  }
}
